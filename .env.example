# AI sales assistant. The five core predictions never need any of this.
# Pick ONE provider. Default (auto): the first provider that has a key below, otherwise the free built-in assistant.
COOLROOF_LLM_PROVIDER=builtin          # builtin | gemini | groq | openrouter | ollama | openai_compat | anthropic | off

# --- Option A: built-in (FREE, offline, no account) ------------------------------------------
# nothing else to set.

# --- Option B: Google Gemini free tier (key from https://aistudio.google.com/apikey) ---------
# COOLROOF_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key
# COOLROOF_LLM_MODEL=gemini-flash-lite-latest   # optional. Free tiers have small daily request limits and old model names get retired;
#                                                  # the '-latest' aliases are the safest. The app falls back to the built-in assistant when a limit is hit.

# --- Option C: Groq free tier (key from https://console.groq.com) ----------------------------
# COOLROOF_LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-key
# COOLROOF_LLM_MODEL=llama-3.3-70b-versatile

# --- Option D: local Ollama (free, runs on your PC; `ollama pull llama3.1` first) ------------
# COOLROOF_LLM_PROVIDER=ollama
# COOLROOF_LLM_MODEL=llama3.1

# --- Option E: any OpenAI-compatible server --------------------------------------------------
# COOLROOF_LLM_PROVIDER=openai_compat
# COOLROOF_LLM_BASE_URL=https://example.com/v1
# COOLROOF_LLM_API_KEY=your-key

# --- Option F: Claude (paid API credit required) ---------------------------------------------
# COOLROOF_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key

# Other optional settings
# COOLROOF_CORS_ORIGINS=http://localhost:5173
